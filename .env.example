# ==========================================================
# 1. SHOPIFY STORE & PREVIEW CONFIGURATION
# ==========================================================
# Project or Client Name
# Example: PROJECT_NAME="Scroggin Wanaka"
PROJECT_NAME="Irreverent"

# Shopify Store Domain (Root domain without preview parameters)
# Example: SHOPIFY_STORE_URL="https://www.scrogginwanaka.co.nz"
SHOPIFY_STORE_URL="https://admin.shopify.com/store/irreverent-ink-2/themes?appLoadId=dd91ef3d-4461-4077-932f-3cf8f58c1e9a"

# Shopify Preview Theme ID (Numeric ID from Shopify Admin -> Online Store -> Themes)
# Example: SHOPIFY_THEME_ID="159358451909"
SHOPIFY_THEME_ID="181104476407"

# Storefront Password (If the Shopify development store has a password page)
# Example: SHOPIFY_STOREFRONT_PASSWORD="mysecretpassword"
SHOPIFY_STOREFRONT_PASSWORD=""

# Is Storefront Password-Protected? (true or false)
# Example: PASSWORD_PROTECTED="false"
PASSWORD_PROTECTED="false"

# Full Direct Preview URL (Including theme preview parameters if provided by developer)
# Example: PREVIEW_URL="https://www.scrogginwanaka.co.nz/?_ab=0&_fd=0&_sc=1&preview_theme_id=159358451909"
PREVIEW_URL="https://www.irreverentink.com/?preview_theme_id=181104476407"

# Base Store URL fallback
# Example: PREVIEW_BASE_URL="https://www.scrogginwanaka.co.nz"
PREVIEW_BASE_URL=""

# ==========================================================
# 2. FIGMA ACCESS (Used ONLY once for "figma:freeze", then offline)
# ==========================================================
# Full Figma Design URL for the file/page
# Example: FIGMA_URL="https://www.figma.com/design/hBqls3TqMn91gu7Y3OHwcO/Scroggin--Copy-?node-id=50-3&m=dev"
FIGMA_URL="https://www.figma.com/design/Dw1Dj8TdcDwpvnshkjytBG/Irreverent-Website?node-id=41-505&m=dev"

# Personal Figma Access Token (from Figma -> Account Settings -> Personal Access Tokens)
# Example: FIGMA_ACCESS_TOKEN=""
FIGMA_ACCESS_TOKEN=""

# Figma Data Source ('offline' to run against saved snapshots, 'live' only during refresh)
# Example: FIGMA_SOURCE="offline"
FIGMA_SOURCE="offline"

# ==========================================================
# 3. CLICKUP BUG TRACKING INTEGRATION
# ==========================================================
# ClickUp Personal API Token (from ClickUp Settings -> Apps -> API Token)
# Example: CLICKUP_API_TOKEN=""
CLICKUP_API_TOKEN=""

# ClickUp Target List ID (from ClickUp URL: https://app.clickup.com/1234567/v/li/901802345678 -> numeric ID after /li/)
# Example: CLICKUP_LIST_ID="901802345678"
CLICKUP_LIST_ID="1301100000003827"
